* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Arial, sans-serif;
}

body {
    background: #141414;
    color: #fff;
    overflow-x: hidden;
}

/* Header */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    background: linear-gradient(180deg, rgba(0,0,0,0.9) 0%, transparent 100%);
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 100;
}

.logo {
    font-size: 28px;
    font-weight: 900;
    color: #e50914;
    letter-spacing: 2px;
}

.buscador {
    padding: 10px 20px;
    border-radius: 20px;
    border: none;
    background: rgba(255,255,255,0.1);
    color: #fff;
    width: 250px;
    outline: none;
}

.buscador::placeholder {
    color: #aaa;
}

/* Hero */
.hero {
    height: 70vh;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
    padding: 60px 40px;
    position: relative;
}

.hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, #141414 0%, rgba(20,20,20,0.5) 50%, transparent 100%);
}

.hero-contenido {
    position: relative;
    z-index: 2;
    max-width: 600px;
}

.hero h1 {
    font-size: 48px;
    margin-bottom: 15px;
    text-shadow: 2px 2px 8px rgba(0,0,0,0.8);
}

.hero p {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 20px;
    text-shadow: 1px 1px 4px rgba(0,0,0,0.8);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.btn-hero {
    padding: 12px 30px;
    background: #e50914;
    color: #fff;
    border: none;
    border-radius: 4px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.3s;
}

.btn-hero:hover {
    background: #f40612;
}

/* Filtros */
.filtros {
    padding: 20px 40px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    position: relative;
    z-index: 3;
    margin-top: -40px;
}

.filtro-btn {
    padding: 8px 18px;
    background: rgba(255,255,255,0.1);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.3s;
    font-size: 14px;
}

.filtro-btn:hover,
.filtro-btn.activo {
    background: #e50914;
    border-color: #e50914;
}

/* Catálogo */
.seccion-titulo {
    padding: 20px 40px;
    font-size: 24px;
}

.catalogo {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
    padding: 20px 40px 60px;
}

.tarjeta {
    background: #1f1f1f;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s, box-shadow 0.3s;
}

.tarjeta:hover {
    transform: scale(1.05);
    box-shadow: 0 10px 30px rgba(229,9,20,0.4);
}

.tarjeta-imagen {
    height: 280px;
    background: linear-gradient(135deg, #2a2a2a, #1a1a1a);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 60px;
    position: relative;
}

.tarjeta-info {
    padding: 15px;
}

.tarjeta-info h3 {
    font-size: 16px;
    margin-bottom: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.tarjeta-meta {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #aaa;
    margin-bottom: 8px;
}

.tarjeta-generos {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
}

.genero-tag {
    font-size: 10px;
    padding: 2px 8px;
    background: rgba(229,9,20,0.2);
    color: #e50914;
    border-radius: 10px;
}

/* Modal */
.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    z-index: 200;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal.activo {
    display: flex;
}

.modal-contenido {
    background: #1f1f1f;
    padding: 40px;
    border-radius: 12px;
    max-width: 600px;
    width: 100%;
    position: relative;
}

.cerrar {
    position: absolute;
    top: 15px;
    right: 25px;
    font-size: 32px;
    cursor: pointer;
    color: #aaa;
}

.cerrar:hover {
    color: #e50914;
}

.modal-contenido h2 {
    color: #e50914;
    margin-bottom: 15px;
    font-size: 28px;
}

.modal-contenido p {
    line-height: 1.7;
    margin-bottom: 12px;
    color: #ddd;
}

/* Responsive */
@media (max-width: 768px) {
    .header { padding: 15px 20px; }
    .logo { font-size: 22px; }
    .buscador { width: 150px; }
    .hero { padding: 40px 20px; height: 60vh; }
    .hero h1 { font-size: 32px; }
    .filtros, .seccion-titulo, .catalogo { padding-left: 20px; padding-right: 20px; }
    .catalogo { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
    .tarjeta-imagen { height: 200px; }
}
